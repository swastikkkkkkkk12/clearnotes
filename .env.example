# Copy this file to .env to customize local ports and credentials.
MYSQL_DATABASE=clearnotes
MYSQL_USER=clearnotes
MYSQL_PASSWORD=clearnotes_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306
BACKEND_PORT=8080
TRANSCRIPTION_PORT=8000

# Generate a unique local signing key with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_base64_secret
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=4
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
